me":"twitter:description","content":"Enterprise AI, healthcare decision systems, applied ML research, and analytics impact."}],["$","meta","14",{"name":"twitter:image","content":"https://anuraagbhavaraju.github.io/og.png"}],["$","link","15",{"rel":"shortcut icon","href":"https://anuraagbhavaraju.github.io/favicon.svg"}],["$","link","16",{"rel":"icon","href":"https://anuraagbhavaraju.github.io/favicon.svg"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["case-studies","occupational-burnout-estimation"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/case-studies/occupational-burnout-estimation/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:16e2pkfyc4ff4","deploymentVersion":"8c101f9c-ae08-4053-9d81-570cfe80a1ab","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:["$","main",null,{"className":"case-study-main","children":[["$","nav",null,{"className":"case-nav","aria-label":"Case study navigation","children":[["$","a",null,{"className":"brand-mark","href":"/","aria-label":"Anuraag Bhavaraju home","children":"AB"}],["$","a",null,{"className":"button secondary-button","href":"/#work","children":"Back To Portfolio"}]]}],["$","article",null,{"className":"case-study-article","children":[["$","header",null,{"className":"case-hero","children":[["$","p",null,{"className":"section-kicker","children":"Selected Research"}],["$","p",null,{"className":"case-eyebrow","children":["Workforce Wellbeing Analytics"," - ","3-5 min read"]}],["$","h1",null,{"children":"Occupational Burnout Estimation"}],["$","p",null,{"children":"A multi-dimensional analytics project that uses structured ratings and unstructured employee feedback to estimate burnout risk and translate workforce signals into actionable HR recommendations."}]]}],["$","section",null,{"className":"case-stats","aria-label":"Key proof points","children":[["$","div","97k employee reviews referenced in the ISB research profile",{"children":"97k employee reviews referenced in the ISB research profile"}],["$","div","3 latent burnout axes",{"children":"3 latent burnout axes"}],["$","div","K-means segments: Healthy, Transition to Burnout, Burnout",{"children":"K-means segments: Healthy, Transition to Burnout, Burnout"}],["$","div","Best Capstone Project, ISB",{"children":"Best Capstone Project, ISB"}]]}],["$","div",null,{"className":"case-body","children":[["$","aside",null,{"className":"case-sidebar","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Methods"}],["$","div",null,{"className":"tag-row","children":[["$","span","Factor analysis",{"children":"Factor analysis"}],["$","span","K-means clustering",{"children":"K-means clustering"}],["$","span","VADER",{"children":"VADER"}],["$","span","BERTopic",{"children":"BERTopic"}],["$","span","Random Forest",{"children":"Random Forest"}],["$","span","Bi-LSTM",{"children":"Bi-LSTM"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Further Reading"}],["$","ul",null,{"className":"source-list","children":[["$","li","https://www.isb.edu/faculty-and-research/isb-institute-of-data-science/research/using-a-combination-of-multiple-facets-of-health-engagement-and-productivity-to-estimate-occupational-burnout",{"children":["$","a",null,{"href":"https://www.isb.edu/faculty-and-research/isb-institute-of-data-science/research/using-a-combination-of-multiple-facets-of-health-engagement-and-productivity-to-estimate-occupational-burnout","target":"_blank","rel":"noreferrer","children":"ISB occupational burnout research profile"}]}],["$","li","/files/eba5002-occupational-burnout-final-report.pdf",{"children":["$","a",null,{"href":"/files/eba5002-occupational-burnout-final-report.pdf","target":"$undefined","rel":"$undefined","children":"Full EBA5002 final report"}]}]]}]]}]]}],["$","div",null,{"className":"case-sections","children":[["$","section","The Problem",{"children":[["$","h2",null,{"children":"The Problem"}],[["$","p","Burnout is difficult to manage because it is not a single metric. It shows up through exhaustion, cynicism, reduced efficacy, disengagement, absenteeism, attrition, and declining productivity. The ISB research page frames it as a multi-dimensional occupational phenomenon and describes the goal as helping employers understand their employees better through the burnout lens.",{"children":"Burnout is difficult to manage because it is not a single metric. It shows up through exhaustion, cynicism, reduced efficacy, disengagement, absenteeism, attrition, and declining productivity. The ISB research page frames it as a multi-dimensional occupational phenomenon and describes the goal as helping employers understand their employees better through the burnout lens."}],["$","p","The project turns that broad problem into a data science pipeline. The aim is early detection: identify risk drivers before interventions become purely reactive. For leaders and HR teams, the practical question is not just whether burnout exists, but which groups are at risk, what factors are driving the risk, and what actions could improve wellbeing and retention.",{"children":"The project turns that broad problem into a data science pipeline. The aim is early detection: identify risk drivers before interventions become purely reactive. For leaders and HR teams, the practical question is not just whether burnout exists, but which groups are at risk, what factors are driving the risk, and what actions could improve wellbeing and retention."}]]]}],"$L6","$L7"]}]]}]]}]]}]
6:["$","section","The Data And Modelling Approach",{"children":[["$","h2",null,{"children":"The Data And Modelling Approach"}],[["$","p","The project combined structured ratings with unstructured review text. The ISB page references reviews of about 97k employees across four companies and describes factor analysis over ratings data. The project report expands the analytical stack: anomaly detection with Isolation Forest, association rules, PCA, confirmatory factor analysis, K-means clustering, sentiment analysis, topic modelling, regression, tree-based models, Bi-LSTM, and transformer-based predictive modelling.",{"children":"The project combined structured ratings with unstructured review text. The ISB page references reviews of about 97k employees across four companies and describes factor analysis over ratings data. The project report expands the analytical stack: anomaly detection with Isolation Forest, association rules, PCA, confirmatory factor analysis, K-means clustering, sentiment analysis, topic modelling, regression, tree-based models, Bi-LSTM, and transformer-based predictive modelling."}],["$","p","The core interpretability move was the latent factor design. Variables such as work-life balance, company culture, work satisfaction, career growth, salary benefits, skill development, and job security were mapped into meaningful burnout axes. In the final framing, the employee experience was represented through factors such as exhaustion, depersonalisation, and personal growth. K-means then segmented employees into Healthy, Transition to Burnout, and Burnout groups.",{"children":"The core interpretability move was the latent factor design. Variables such as work-life balance, company culture, work satisfaction, career growth, salary benefits, skill development, and job security were mapped into meaningful burnout axes. In the final framing, the employee experience was represented through factors such as exhaustion, depersonalisation, and personal growth. K-means then segmented employees into Healthy, Transition to Burnout, and Burnout groups."}]]]}]
7:["$","section","What Made It Useful",{"children":[["$","h2",null,{"children":"What Made It Useful"}],[["$","p","The modelling was not only predictive; it was explanatory. The report describes OLS regression over latent factors with an R2 of 0.745, indicating that the psychological factors explained a large share of variance in employee satisfaction-related outcomes. The tree-based models helped identify interpretable drivers such as work-life balance, job satisfaction, management rating, and sentiment score.",{"children":"The modelling was not only predictive; it was explanatory. The report describes OLS regression over latent factors with an R2 of 0.745, indicating that the psychological factors explained a large share of variance in employee satisfaction-related outcomes. The tree-based models helped identify interpretable drivers such as work-life balance, job satisfaction, management rating, and sentiment score."}],["$","p","The NLP layer added texture that ratings alone cannot capture. VADER sentiment scoring helped separate positive and negative review corpora, while topic modelling surfaced themes that leaders could act on. This combination matters because burnout is both quantitative and narrative: numbers show the pattern, text explains the lived experience behind it.",{"children":"The NLP layer added texture that ratings alone cannot capture. VADER sentiment scoring helped separate positive and negative review corpora, while topic modelling surfaced themes that leaders could act on. This combination matters because burnout is both quantitative and narrative: numbers show the pattern, text explains the lived experience behind it."}]]]}]
