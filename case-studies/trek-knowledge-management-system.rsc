1:["$","main",null,{"className":"case-study-main","children":[["$","nav",null,{"className":"case-nav","aria-label":"Case study navigation","children":[["$","a",null,{"className":"brand-mark","href":"/","aria-label":"Anuraag Bhavaraju home","children":"AB"}],["$","a",null,{"className":"button secondary-button","href":"/#work","children":"Back To Portfolio"}]]}],["$","article",null,{"className":"case-study-article","children":[["$","header",null,{"className":"case-hero","children":[["$","p",null,{"className":"section-kicker","children":"Selected Work"}],["$","p",null,{"className":"case-eyebrow","children":["Enterprise Knowledge AI"," - ","3-5 min read"]}],["$","h1",null,{"children":"TReK Knowledge Management System"}],["$","p",null,{"children":"A GenAI-powered enterprise knowledge platform designed to collapse information search from hours into seconds and make organizational knowledge easier to discover, reuse, and trust."}]]}],["$","section",null,{"className":"case-stats","aria-label":"Key proof points","children":[["$","div","90% faster enterprise search",{"children":"90% faster enterprise search"}],["$","div","75,000+ corporate assets indexed",{"children":"75,000+ corporate assets indexed"}],["$","div","4,000+ employees reached",{"children":"4,000+ employees reached"}],["$","div","Built around agentic AI and multi-modal RAG",{"children":"Built around agentic AI and multi-modal RAG"}]]}],["$","div",null,{"className":"case-body","children":[["$","aside",null,{"className":"case-sidebar","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Methods"}],["$","div",null,{"className":"tag-row","children":[["$","span","Agentic AI",{"children":"Agentic AI"}],["$","span","Multi-modal RAG",{"children":"Multi-modal RAG"}],["$","span","Enterprise search",{"children":"Enterprise search"}],["$","span","Knowledge retrieval",{"children":"Knowledge retrieval"}],["$","span","LLM UX",{"children":"LLM UX"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Further Reading"}],["$","ul",null,{"className":"source-list","children":[["$","li","https://www.linkedin.com/posts/tredence_built-at-tredence-activity-7412803390642188288-4sNq/",{"children":["$","a",null,{"href":"https://www.linkedin.com/posts/tredence_built-at-tredence-activity-7412803390642188288-4sNq/","target":"_blank","rel":"noreferrer","children":"Tredence LinkedIn launch post"}]}],["$","li","https://www.tredence.com/maximizing-business-impact-with-generative-ai",{"children":["$","a",null,{"href":"https://www.tredence.com/maximizing-business-impact-with-generative-ai","target":"_blank","rel":"noreferrer","children":"Tredence GenAI healthcare and life sciences PoV mentioning TREK"}]}]]}]]}]]}],["$","div",null,{"className":"case-sections","children":[["$","section","The Problem",{"children":[["$","h2",null,{"children":"The Problem"}],[["$","p","Enterprise knowledge is rarely absent. It is usually hidden: in old decks, project folders, proposal archives, expert inboxes, policy documents, solution collateral, and shared drives that each team navigates differently. For consulting, analytics, and AI delivery teams, that creates a very real productivity tax. A case study might exist, a reusable approach might exist, or an internal expert might have already solved the same problem, but finding that evidence can take longer than starting from scratch.",{"children":"Enterprise knowledge is rarely absent. It is usually hidden: in old decks, project folders, proposal archives, expert inboxes, policy documents, solution collateral, and shared drives that each team navigates differently. For consulting, analytics, and AI delivery teams, that creates a very real productivity tax. A case study might exist, a reusable approach might exist, or an internal expert might have already solved the same problem, but finding that evidence can take longer than starting from scratch."}],"$L6"]]}],"$L7"]}]]}]]}]]}]
6:["$","p","TReK was positioned as an answer to that friction. Public Tredence material describes it as an AI-powered central hub for access to critical organizational documents, and the LinkedIn launch post frames the core idea simply: when information hides, productivity suffers. The portfolio version of this story should emphasize the underlying product problem: retrieval is not just search, it is a workflow that affects delivery speed, reuse, collaboration, and confidence.",{"children":"TReK was positioned as an answer to that friction. Public Tredence material describes it as an AI-powered central hub for access to critical organizational documents, and the LinkedIn launch post frames the core idea simply: when information hides, productivity suffers. The portfolio version of this story should emphasize the underlying product problem: retrieval is not just search, it is a workflow that affects delivery speed, reuse, collaboration, and confidence."}]
7:["$","section","The System Idea",{"children":[["$","h2",null,{"children":"The System Idea"}],[["$","p","The system works as a knowledge management layer over a large internal corpus. Instead of asking users to remember where something lives, the platform lets them ask for what they need: a relevant client example, a policy reference, a reusable analytical approach, a proposal snippet, or a person who might know the answer. Behind that experience is the familiar RAG pattern, but adapted for enterprise use where source quality, access control, freshness, document structure, and answer traceability matter.",{"children":"The system works as a knowledge management layer over a large internal corpus. Instead of asking users to remember where something lives, the platform lets them ask for what they need: a relevant client example, a policy reference, a reusable analytical approach, a proposal snippet, or a person who might know the answer. Behind that experience is the familiar RAG pattern, but adapted for enterprise use where source quality, access control, freshness, document structure, and answer traceability matter."}],["$","p","The resume-backed metrics are the clearest impact signal: the system ingested 75,000+ corporate assets and reached 4,000+ employees, reducing internal search time by 90%. That is not just a better interface. It is a shift from manual knowledge hunting to intelligent self-service, with enough scale to change daily work habits across an organization.",{"children":"The resume-backed metrics are the clearest impact signal: the system ingested 75,000+ corporate assets and reached 4,000+ employees, reducing internal search time by 90%. That is not just a better interface. It is a shift from manual knowledge hunting to intelligent self-service, with enough scale to change daily work habits across an organization."}]]]}]
