$","meta","13",{"name":"twitter:description","content":"Enterprise AI, healthcare decision systems, applied ML research, and analytics impact."}],["$","meta","14",{"name":"twitter:image","content":"https://anuraagbhavaraju.github.io/og.png"}],["$","link","15",{"rel":"shortcut icon","href":"https://anuraagbhavaraju.github.io/favicon.svg"}],["$","link","16",{"rel":"icon","href":"https://anuraagbhavaraju.github.io/favicon.svg"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["case-studies","biological-age-modelling-novagene"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/case-studies/biological-age-modelling-novagene/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:16e2pkfyc4ff4","deploymentVersion":"8c101f9c-ae08-4053-9d81-570cfe80a1ab","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:["$","main",null,{"className":"case-study-main","children":[["$","nav",null,{"className":"case-nav","aria-label":"Case study navigation","children":[["$","a",null,{"className":"brand-mark","href":"/","aria-label":"Anuraag Bhavaraju home","children":"AB"}],["$","a",null,{"className":"button secondary-button","href":"/#work","children":"Back To Portfolio"}]]}],["$","article",null,{"className":"case-study-article","children":[["$","header",null,{"className":"case-hero","children":[["$","p",null,{"className":"section-kicker","children":"Selected Research"}],["$","p",null,{"className":"case-eyebrow","children":["Cloud Epigenomics"," - ","3-5 min read"]}],["$","h1",null,{"children":"Biological Age Modelling: NovaGene"}],["$","p",null,{"children":"A cloud-native epigenomic platform that processes raw DNA methylation array data, computes validated biological-age clocks, and serves cohort and individual reports through Azure, Power BI, and Streamlit."}]]}],["$","section",null,{"className":"case-stats","aria-label":"Key proof points","children":[["$","div","24 real PGP UK participant samples",{"children":"24 real PGP UK participant samples"}],["$","div","48 IDAT files processed",{"children":"48 IDAT files processed"}],["$","div","11,652,288 CpG methylation measurements",{"children":"11,652,288 CpG methylation measurements"}],["$","div","Horvath, Hannum, and GrimAge clocks",{"children":"Horvath, Hannum, and GrimAge clocks"}]]}],["$","div",null,{"className":"case-body","children":[["$","aside",null,{"className":"case-sidebar","children":[["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Methods"}],["$","div",null,{"className":"tag-row","children":[["$","span","DNA methylation",{"children":"DNA methylation"}],["$","span","Elastic Net",{"children":"Elastic Net"}],["$","span","LASSO",{"children":"LASSO"}],["$","span","Azure Data Factory",{"children":"Azure Data Factory"}],["$","span","PySpark",{"children":"PySpark"}],["$","span","Power BI",{"children":"Power BI"}]]}]]}],["$","div",null,{"children":[["$","p",null,{"className":"section-kicker","children":"Further Reading"}],["$","ul",null,{"className":"source-list","children":[["$","li","/files/eba5006-novagene-biological-age-report.pdf",{"children":["$","a",null,{"href":"/files/eba5006-novagene-biological-age-report.pdf","target":"$undefined","rel":"$undefined","children":"Full NovaGene project report"}]}],["$","li","https://github.com/AyaanIrfanNUS/novagene-epigenetic-dashboard",{"children":["$","a",null,{"href":"https://github.com/AyaanIrfanNUS/novagene-epigenetic-dashboard","target":"_blank","rel":"noreferrer","children":"NovaGene dashboard repository referenced in the report"}]}]]}]]}]]}],["$","div",null,{"className":"case-sections","children":[["$","section","The Problem",{"children":[["$","h2",null,{"children":"The Problem"}],[["$","p","Biological age modelling asks a deceptively simple question: does a person's cellular aging signal look older or younger than their chronological age? DNA methylation makes that question measurable because methylation patterns at CpG sites change predictably with age. The challenge is operational. Raw IDAT files from methylation arrays are large, technical, and usually require specialized local bioinformatics environments to process.",{"children":"Biological age modelling asks a deceptively simple question: does a person's cellular aging signal look older or younger than their chronological age? DNA methylation makes that question measurable because methylation patterns at CpG sites change predictably with age. The challenge is operational. Raw IDAT files from methylation arrays are large, technical, and usually require specialized local bioinformatics environments to process."}],["$","p","NovaGene was designed as an end-to-end platform to close that engineering gap. Instead of treating epigenetic clocks as a one-off notebook exercise, the project built a cloud pipeline that ingests raw epigenomic data, processes methylation signals, computes validated clocks, and presents results in dashboards and individual reports.",{"children":"NovaGene was designed as an end-to-end platform to close that engineering gap. Instead of treating epigenetic clocks as a one-off notebook exercise, the project built a cloud pipeline that ingests raw epigenomic data, processes methylation signals, computes validated clocks, and presents results in dashboards and individual reports."}]]]}],"$L6","$L7","$L8"]}]]}]]}]]}]
6:["$","section","The Data And Clock Models",{"children":[["$","h2",null,{"children":"The Data And Clock Models"}],[["$","p","The project used Personal Genome Project UK data, accessed through API metadata and FTP-hosted IDAT files. The report describes 24 participant samples, 48 IDAT files, and 24 x 485,512 CpG methylation measurements. That creates the classic high-dimensional modelling context: far more methylation features than samples, requiring careful feature selection, prior clock definitions, and robust data processing.",{"children":"The project used Personal Genome Project UK data, accessed through API metadata and FTP-hosted IDAT files. The report describes 24 participant samples, 48 IDAT files, and 24 x 485,512 CpG methylation measurements. That creates the classic high-dimensional modelling context: far more methylation features than samples, requiring careful feature selection, prior clock definitions, and robust data processing."}],["$","p","The modelling layer focused on three epigenetic clocks. Horvath's pan-tissue clock uses elastic net regression and a 353-CpG signature. Hannum's blood-calibrated clock uses LASSO and 71 CpG predictors. GrimAge incorporates methylation signals connected to plasma protein surrogates, smoking exposure, mortality, and healthspan risk. Together, the clocks provide complementary views of biological aging rather than a single absolute truth.",{"children":"The modelling layer focused on three epigenetic clocks. Horvath's pan-tissue clock uses elastic net regression and a 353-CpG signature. Hannum's blood-calibrated clock uses LASSO and 71 CpG predictors. GrimAge incorporates methylation signals connected to plasma protein surrogates, smoking exposure, mortality, and healthspan risk. Together, the clocks provide complementary views of biological aging rather than a single absolute truth."}]]]}]
7:["$","section","The Platform Architecture",{"children":[["$","h2",null,{"children":"The Platform Architecture"}],[["$","p","NovaGene was built on Microsoft Azure with a layered architecture: PGP UK API and FTP sources, Azure Data Factory for orchestration, Azure Data Lake Gen2 with landing/raw/processing/output zones, an Ubuntu VM for heavy R and Spark computation, Azure SQL for analytical serving, and Power BI plus Streamlit for user-facing interpretation.",{"children":"NovaGene was built on Microsoft Azure with a layered architecture: PGP UK API and FTP sources, Azure Data Factory for orchestration, Azure Data Lake Gen2 with landing/raw/processing/output zones, an Ubuntu VM for heavy R and Spark computation, Azure SQL for analytical serving, and Power BI plus Streamlit for user-facing interpretation."}],["$","p","The report highlights practical engineering constraints too. Under an Azure for Students subscription, service principal creation was restricted, so the team introduced an Azure Function App as an HTTP bridge between Data Factory and the VM. Spark was used in both SparkR and PySpark contexts to convert outputs to Parquet and unify feature engineering across SQL tables.",{"children":"The report highlights practical engineering constraints too. Under an Azure for Students subscription, service principal creation was restricted, so the team introduced an Azure Function App as an HTTP bridge between Data Factory and the VM. Spark was used in both SparkR and PySpark contexts to convert outputs to Parquet and unify feature engineering across SQL tables."}]]]}]
8:["$","section","My Role And Takeaway",{"children":[["$","h2",null,{"children":"My Role And Takeaway"}],[["$","p","My contribution covered exploratory data analysis, data understanding, domain understanding, and the Horvath and Hannum machine learning algorithm sections. That role matters because biological age modelling is not only implementation. It requires understanding how methylation clocks were constructed, why regularization is essential in high-dimensional epigenomic data, and how to explain age acceleration to non-specialist users.",{"children":"My contribution covered exploratory data analysis, data understanding, domain understanding, and the Horvath and Hannum machine learning algorithm sections. That role matters because biological age modelling is not only implementation. It requires understanding how methylation clocks were constructed, why regularization is essential in high-dimensional epigenomic data, and how to explain age acceleration to non-specialist users."}],["$","p","As a portfolio story, NovaGene shows a different side of applied ML: healthcare-adjacent data engineering, high-dimensional modelling, cloud orchestration, and interpretable analytics. It is a strong research card because it connects statistical learning with a deployable data platform and a user-facing reporting layer.",{"children":"As a portfolio story, NovaGene shows a different side of applied ML: healthcare-adjacent data engineering, high-dimensional modelling, cloud orchestration, and interpretable analytics. It is a strong research card because it connects statistical learning with a deployable data platform and a user-facing reporting layer."}]]]}]
